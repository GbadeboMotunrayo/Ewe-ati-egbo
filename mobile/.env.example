# Copy to .env and fill in. Without these, the app runs in demo mode against
# src/data/mockData.ts — enough to click through every screen, nothing persists.

# Supabase project — supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Paystack public key — safe to embed in the client. dashboard.paystack.com -> Settings -> API Keys.
# The SECRET key is never here — it lives only in Supabase Edge Function config.
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
