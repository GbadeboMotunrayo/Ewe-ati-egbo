# Copy to .env
NODE_ENV=development
PORT=4000
# HOST defaults to 127.0.0.1 in dev, 0.0.0.0 in production
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eweatiegbo
# Required in production: at least 32 random chars. Generate: openssl rand -base64 48
JWT_SECRET=
# Comma-separated browser origins allowed to call the API (production)
CORS_ORIGINS=
# Number of reverse proxies in front of the API (Render/Fly/Nginx = 1)
TRUST_PROXY_HOPS=0
# Paystack secret lives ONLY here (server-side), never in the mobile client.
PAYSTACK_SECRET_KEY=
